{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PdfStorage": {
    "MaxFileSizeMB": 50,
    "RetentionMinutes": 60
  },
  "Https": {
    "Redirect": true,
    "Port": 443,
    "HstsDays": 30
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 1200,
    "UploadsPerMinute": 30,
    "ToolsPerMinute": 20
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}

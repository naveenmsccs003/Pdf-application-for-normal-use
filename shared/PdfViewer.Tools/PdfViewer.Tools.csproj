<Project Sdk="Microsoft.NET.Sdk">

  <!-- PDF tools shared by the web backend and the desktop app: merge, split, compress, convert. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfViewer.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PDFiumCore" Version="156.0.8076" />
  </ItemGroup>

</Project>
